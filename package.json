{
  "name": "obsidian-cobrain",
  "version": "0.6.3",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "deploy": "npm run build && node deploy.mjs",
    "test": "jest",
    "test:ui": "node scripts/verify-ui.mjs",
    "lint": "eslint . --max-warnings 8",
    "check:plugin": "node scripts/check-plugin.mjs"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.0",
    "esbuild": "^0.21.5",
    "eslint": "9.39.5",
    "eslint-plugin-obsidianmd": "0.4.2",
    "jest": "^29.7.0",
    "obsidian": "1.13.1",
    "ts-jest": "^29.1.4",
    "typescript": "^5.4.5",
    "typescript-eslint": "8.72.1"
  }
}
